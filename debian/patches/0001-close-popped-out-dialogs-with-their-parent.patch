+static void GTKNoCSDParentUnrealize(GtkWidget *Parent, AdwDialog *Dialog);
+
 void adw_dialog_present(AdwDialog *Child, GtkWidget *Parent) {
 	// LibAdwaita uses embedded dialogs which break most themes. This pops them
 	// out into their own window
@@ -3361,6 +3376,15 @@ void adw_dialog_present(AdwDialog *Child
 				(GActionGroup *) ParentWindow);
 		}
 
+		// Close the dialog when the parent is destroyed, as an embedded dialog
+		// goes with its window. Connect once per parent, until the dialog goes
+		if (o_g_signal_handler_find((GObject *) ParentWindow,
+			G_SIGNAL_MATCH_FUNC | G_SIGNAL_MATCH_DATA, 0, 0, NULL,
+			(GCallback *) GTKNoCSDParentUnrealize, Child) == 0) {
+			o_g_signal_connect_object(ParentWindow, "unrealize",
+				G_CALLBACK(GTKNoCSDParentUnrealize), Child, 0);
+		}
+
 		// Get size of parent window
 		ParentWidth = o_gtk_widget_get_width((GtkWidget *) ParentWindow);
 		ParentHeight = o_gtk_widget_get_height((GtkWidget *) ParentWindow);
@@ -3441,6 +3465,49 @@ void GTKNoCSDUnsetDialogWindow(GtkWindow
 	}
 }
 
+static void GTKNoCSDCloseDialog(AdwDialog *Dialog) {
+	// Close a popped out dialog even if it can not be closed by the user,
+	// emitting closed once, and remove its window from the list
+
+	GtkWindow *Window = (GtkWindow *) o_gtk_widget_get_ancestor(
+		(GtkWidget *) Dialog, GTKNoCSDGTKWindow);
+
+	o_g_object_ref((GObject *) Dialog);
+	gboolean CanClose = o_adw_dialog_get_can_close(Dialog);
+	o_adw_dialog_set_can_close(Dialog, true);
+	o_adw_dialog_close(Dialog);
+	o_adw_dialog_set_can_close(Dialog, CanClose);
+
+	if (Window != NULL) {
+		GTKNoCSDUnsetDialogWindow(Window);
+	}
+	o_g_object_unref((GObject *) Dialog);
+}
+
+static void GTKNoCSDParentUnrealize(GtkWidget *Parent, AdwDialog *Dialog) {
+	// The parent of a popped out dialog is unrealized. Close the dialog only if
+	// the parent was destroyed, which removes it from the toplevel windows
+
+	GListModel *Toplevels = o_gtk_window_get_toplevels();
+	guint Count = o_g_list_model_get_n_items(Toplevels);
+	for (guint Index = 0; Index < Count; ++Index) {
+		GObject *Toplevel = o_g_list_model_get_item(Toplevels, Index);
+		bool Found = Toplevel == (GObject *) Parent;
+		o_g_object_unref(Toplevel);
+		if (Found) {
+			return;
+		}
+	}
+
+	// Only if the dialog is still in a window transient for this parent
+	GtkWindow *Window = (GtkWindow *) o_gtk_widget_get_ancestor(
+		(GtkWidget *) Dialog, GTKNoCSDGTKWindow);
+	if (Window != NULL &&
+		o_gtk_window_get_transient_for(Window) == (GtkWindow *) Parent) {
+		GTKNoCSDCloseDialog(Dialog);
+	}
+}
