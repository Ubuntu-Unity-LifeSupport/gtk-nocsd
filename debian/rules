#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_LDFLAGS_MAINT_APPEND = -Wl,-O1 -Wl,-z,defs
export DPKG_GENSYMBOLS_CHECK_LEVEL = 4

export NOOPT=1
export PREFIX=/usr
export LIBDIR=$(PREFIX)/lib/$(DEB_HOST_MULTIARCH)

%:
	dh $@

execute_after_dh_auto_install:
	rm -rf debian/*/usr/share/licenses
	rm -rf debian/*/usr/share/doc/gtk-nocsd
	rm -rf debian/*/usr/lib/*/libgtk-nocsd.so

# The Xsession.d script, under dash and bash, with and without set -eu.
execute_after_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	for sh in dash bash; do \
	  for mode in plain strict; do \
	    sh debian/test-51gtk-nocsd.sh debian/51gtk-nocsd $$sh $$mode || exit 1; \
	  done; \
	done
endif

get-orig-source:
	uscan --noconf --force-download --rename --download-current-version --destdir=..
